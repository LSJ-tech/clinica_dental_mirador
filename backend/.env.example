# Copiar a .env para desarrollo local, o cargar como variables de entorno en el
# hosting de producción (en Render, esto se configura en el dashboard del
# servicio o en render.yaml — nunca subiendo este archivo con valores reales).

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---
# Sin definir, se usa SQLite local. En Render se completa sola al conectar
# el servicio de Postgres propio de este cliente (no compartido con
# peluqueria_mascota / PataAgenda).
DATABASE_URL=

# --- CORS (frontend React/Vite) ---
# Sin definir, en desarrollo (DJANGO_DEBUG=True) se permite el dev server
# de Vite (http://localhost:5173). En producción, apuntar al dominio real
# del frontend (ej. https://elmirador.devquad.cl).
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Superusuario inicial (build.sh, producción) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- WhatsApp Cloud API (milestone futuro, dejar vacío por ahora) ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
